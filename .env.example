# Copy to .env (`make setup` does this). Read by docker-compose and the backend.
POSTGRES_USER=demux
POSTGRES_PASSWORD=demux
POSTGRES_DB=demux

DATABASE_URL=postgresql+asyncpg://demux:demux@localhost:5432/demux
TEST_DATABASE_URL=postgresql+asyncpg://demux:demux@localhost:5432/demux_test
FRONTEND_URL=http://localhost:3000
ENV=dev
LOG_LEVEL=INFO

# --- Simple agent MVP ---
BACKEND_URL=http://localhost:8000
# Google Cloud OAuth client (type "Web application"), redirect URI:
#   http://localhost:8000/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Generated by `make setup` when empty. SECRET_KEY signs the Gmail OAuth state.
SECRET_KEY=
TOKEN_ENCRYPTION_KEY=
# Any OpenAI-compatible endpoint with tool calling. LLM_API_KEY falls back to HF_TOKEN.
LLM_BASE_URL=https://router.huggingface.co/v1
LLM_API_KEY=
HF_TOKEN=
BUILD_MODEL=Qwen/Qwen3.8-27B:nebius
SYNC_MODEL=Qwen/Qwen3.8-27B:nebius
# Used when the main model keeps failing (5xx / timeouts). Empty disables it.
LLM_FALLBACK_MODEL=Qwen/Qwen3.8-27B:nscale
# low keeps builds fast; raise for harder inboxes.
LLM_REASONING_EFFORT=none
PROCESS_CONCURRENCY=8
MAX_USD_PER_RUN=3.00
MAX_USD_PER_DAY=15.00
SYNC_INTERVAL_MIN=10
LOOKBACK_DAYS=90
BUILD_MAX_THREADS=80
BATCH_THREADS=6
AGENT_DEBUG_TRANSCRIPTS=false
# Dev only: path (relative to backend/) of a fake mailbox JSON the worker reads instead of Gmail.
DEV_FAKE_MAILBOX=
# Read by docker compose only (the frontend container). Browser-facing backend URL.
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Login (better-auth in the frontend container; native dev: frontend/.env.local) ---
# Generated by `make setup` / `make up` when empty.
BETTER_AUTH_SECRET=
# Production with app.example.com + api.example.com: set to example.com so the API
# receives the login cookie. Leave empty on localhost.
AUTH_COOKIE_DOMAIN=
# Sign-in code emails. With SMTP_HOST empty in dev, codes are printed to the frontend
# log (`make logs s=frontend`). Required in production.
EMAIL_FROM=Demux <support@usedemux.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
