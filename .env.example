# Copy to .env (`make setup` does this). Read by docker-compose and the backend.
POSTGRES_USER=demux
POSTGRES_PASSWORD=demux
POSTGRES_DB=demux

DATABASE_URL=postgresql+asyncpg://demux:demux@localhost:5432/demux
TEST_DATABASE_URL=postgresql+asyncpg://demux:demux@localhost:5432/demux_test
FRONTEND_URL=http://localhost:3000
ENV=dev
LOG_LEVEL=INFO

# Planner (Hugging Face router). HF_TOKEN: fine-grained, "Make calls to Inference Providers".
HF_TOKEN=
PLANNER_MODEL=Qwen/Qwen3.6-35B-A3B
PLANNER_PROVIDER=
PLANNER_THINKING=false
PLANNER_TEMPERATURE=0.2
PLANNER_MAX_TOKENS=4000
