# Copy to .env (`make setup` does this). Read by docker-compose and the backend.
POSTGRES_USER=demux
POSTGRES_PASSWORD=demux
POSTGRES_DB=demux

DATABASE_URL=postgresql+asyncpg://demux:demux@localhost:5432/demux
TEST_DATABASE_URL=postgresql+asyncpg://demux:demux@localhost:5432/demux_test
FRONTEND_URL=http://localhost:3000
ENV=dev
LOG_LEVEL=INFO

# --- Simple agent MVP ---
BACKEND_URL=http://localhost:8000
# Google Cloud OAuth client (type "Web application"), redirect URI:
#   http://localhost:8000/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Generated by `make setup` when empty. SECRET_KEY signs the Gmail OAuth state.
SECRET_KEY=
TOKEN_ENCRYPTION_KEY=
# Any OpenAI-compatible endpoint with tool calling. LLM_API_KEY falls back to HF_TOKEN.
LLM_BASE_URL=https://router.huggingface.co/v1
LLM_API_KEY=
HF_TOKEN=
BUILD_MODEL=Qwen/Qwen3.8-27B:nebius
SYNC_MODEL=Qwen/Qwen3.8-27B:nebius
# Used when the main model keeps failing (5xx / timeouts). Empty disables it.
LLM_FALLBACK_MODEL=Qwen/Qwen3.8-27B:nscale
# low keeps builds fast; raise for harder inboxes.
LLM_REASONING_EFFORT=none
# The interface designer: designs and writes every workspace app (UX and code). Same
# endpoint and key as above. If the router does not serve this model, try another
# provider suffix (:novita, :together, :fireworks-ai) or zai-org/GLM-5.3:deepinfra.
UI_MODEL=zai-org/GLM-5.2:together
# Same model on another provider, used when the first keeps failing. Empty: none.
UI_FALLBACK_MODEL=zai-org/GLM-5.2:coreweave
# none: no hidden reasoning (faster); empty: the provider's default
UI_REASONING_EFFORT=none
UI_MAX_TOKENS=40000
UI_CALL_TIMEOUT_S=300
PROCESS_CONCURRENCY=8
MAX_USD_PER_RUN=3.00
MAX_USD_PER_DAY=15.00
SYNC_INTERVAL_MIN=10
LOOKBACK_DAYS=90
BUILD_MAX_THREADS=80
BATCH_THREADS=6
AGENT_DEBUG_TRANSCRIPTS=false
# Dev only: path (relative to backend/) of a fake mailbox JSON the worker reads instead of Gmail.
DEV_FAKE_MAILBOX=
# Read by docker compose only (the frontend container). Browser-facing backend URL.
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Login (better-auth in the frontend container; native dev: frontend/.env.local) ---
# Generated by `make setup` / `make up` when empty.
BETTER_AUTH_SECRET=
# Production with app.example.com + api.example.com: set to example.com so the API
# receives the login cookie. Leave empty on localhost.
AUTH_COOKIE_DOMAIN=
# Sign-in code emails. With SMTP_HOST empty in dev, codes are printed to the frontend
# log (`make logs s=frontend`). Required in production.
EMAIL_FROM=Demux <support@usedemux.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# --- Admin (/admin) ---
# Comma-separated login emails allowed to open /admin (users.is_admin also grants it).
ADMIN_EMAILS=
# Demo inbox for /admin "Demo inbox": a test Gmail that receives synthetic threads over IMAP.
# TEST_GMAIL_PASSWORD must be a Google *app password* (16 letters; Google account >
# Security > 2-Step Verification > App passwords), not the account password.
TEST_GMAIL=
TEST_GMAIL_PASSWORD=
DEMO_IMAP_HOST=imap.gmail.com
# Model that writes the threads; empty = BUILD_MODEL (Qwen on the Hugging Face router).
DEMO_MODEL=

# --- Access: who may sign up and use Demux (docs/ACCESS.md) ---
# Only paying customers (Stripe), people given free access in /admin/access, and
# ADMIN_EMAILS can create an account or use the app.
# Stripe account the landing page bills with. A *restricted* key with read access to
# Customers and Subscriptions is enough (Demux never writes to Stripe from here).
STRIPE_SECRET_KEY=
# Signing secret of THIS API's webhook endpoint (Stripe dashboard > Developers >
# Webhooks): <BACKEND_URL>/api/v1/billing/stripe/webhook. Local: `stripe listen
# --forward-to localhost:8000/api/v1/billing/stripe/webhook` prints a whsec_...
STRIPE_WEBHOOK_SECRET=
# Shared by the frontend server and the API (the sign-up check). Generated by
# `make setup` / `make up` when empty; set the same value on both in production.
INTERNAL_API_SECRET=
# Where people subscribe (the "no access" screen links here).
LANDING_URL=https://www.usedemux.com
