# Copy to .env.local (`make setup` does this). Read by the Next.js app.

# Browser-facing backend URL.
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Login (better-auth, server side only) ---
# Same Postgres as the backend, plain postgres:// URL (no +asyncpg).
AUTH_DATABASE_URL=postgresql://demux:demux@localhost:5432/demux
# Public URL of this app. `make setup` fills BETTER_AUTH_SECRET when empty.
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
# Production with app.example.com + api.example.com: set to example.com so the API
# receives the session cookie. Leave empty on localhost.
AUTH_COOKIE_DOMAIN=

# --- Sign-in code emails (SMTP). With SMTP_HOST empty in dev, codes are printed to
# this server's log instead. Required in production.
EMAIL_FROM=Demux <support@usedemux.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# --- Sign-up check (only paying customers, free access and admins may create an
# account). Same value as INTERNAL_API_SECRET in the repo-root .env (`make setup` copies it).
INTERNAL_API_SECRET=
# Server-side URL of the API for that check. Empty: NEXT_PUBLIC_API_URL.
BACKEND_INTERNAL_URL=
# Where people subscribe (links on the sign-up form). Default https://www.usedemux.com
NEXT_PUBLIC_LANDING_URL=
